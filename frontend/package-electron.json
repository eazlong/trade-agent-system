{
  "name": "trade-help-system",
  "version": "1.0.0",
  "description": "Trade Help System Desktop App",
  "main": "electron/main.js",
  "scripts": {
    "start": "next start",
    "electron": "electron .",
    "electron-dev": "concurrently \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.tradehelpsystem.app",
    "productName": "Trade Help System",
    "directories": {
      "output": "dist-electron"
    },
    "mac": {
      "category": "public.app-category.finance"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "devDependencies": {
    "electron": "^25.0.0",
    "electron-builder": "^24.0.0",
    "concurrently": "^8.0.0",
    "wait-on": "^7.0.0"
  }
}