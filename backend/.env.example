# Django
SECRET_KEY=change-me-in-production
DJANGO_SETTINGS_MODULE=core.settings.dev
ALLOWED_HOST=localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database
DB_NAME=trade_agent
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379

# LLM
OPENAI_API_KEY=
OPENAI_MODEL_PRIMARY=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FALLBACK=claude-opus-4-6
LLM_TOKEN_BUDGET=100000

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Lark / Feishu
LARK_APP_ID=
LARK_APP_SECRET=
LARK_VERIFICATION_TOKEN=
LARK_ENCRYPT_KEY=
# OAuth (redirect URL must match Feishu app config)
LARK_OAUTH_REDIRECT_URI=http://localhost:8000/api/channel/auth/lark/callback/
LARK_OAUTH_SCOPES=

# Proxies (each can be set independently; all fall back to HTTPS_PROXY if unset)
HTTPS_PROXY=
TELEGRAM_PROXY=
OPENAI_PROXY=
ANTHROPIC_PROXY=
WEB_PROXY=

# Web tools
WEB_SEARCH_PROVIDER=duckduckgo  # brave|tavily|searxng|jina|duckduckgo
WEB_SEARCH_MAX_RESULTS=5
WEB_FETCH_MAX_CHARS=8000
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
SEARXNG_BASE_URL=
JINA_API_KEY=

# Fernet encryption key for API keys (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=
